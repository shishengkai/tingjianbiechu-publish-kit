# tingjianbiechu-publish-kit credentials
# Copy to .env and fill in values you want to override locally.
# Missing .env, or empty values, fall back to the same-named process environment variables.

# fal.ai
FAL_KEY=
FAL_ADMIN_KEY=

# Alibaba Cloud Model Studio (DashScope / 百炼)
DASHSCOPE_API_KEY=
DASHSCOPE_HTTP_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=

# Fish Audio
FISH_API_KEY=

# MVSep
MVSEP_API_KEY=

# TikHub
TIKHUB_API_KEY=

# SnapAny
SNAPANY_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
